NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_PATH=./data/portfolio_gps.db
DATA_DIR=./data
USERS_DIR=./data/users

PYTHON_HOST=127.0.0.1
PYTHON_PORT=8001
PYTHON_HTTP_BASE=http://127.0.0.1:8001
PYTHON_WS_BASE=ws://127.0.0.1:8001

USE_MOCK_PYTHON=1

ALLOWED_ORIGINS=http://localhost:8080

UPLOAD_MAX_MB=10
SESSION_TTL_HOURS=72

# Anthropic — used by both Node canvas-LLM and (separately) the Python AI backend
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Langfuse (self-hosted at http://13.83.220.128:3001)
# Get keys from Langfuse dashboard → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://13.83.220.128:3001
LANGFUSE_HOST=http://13.83.220.128:3001
LANGFUSE_ORGANIZATION_NAME=PortfolioGPS
LANGFUSE_PROJECT_NAME=PortfolioGPS
