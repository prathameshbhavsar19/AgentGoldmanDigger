NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DB_PATH=./data/portfolio_gps.db
DATA_DIR=./data
USERS_DIR=./data/users

PYTHON_HOST=127.0.0.1
PYTHON_PORT=8001
PYTHON_HTTP_BASE=http://127.0.0.1:8001
PYTHON_WS_BASE=ws://127.0.0.1:8001

USE_MOCK_PYTHON=1

ALLOWED_ORIGINS=http://localhost:8080,https://13.83.220.128.nip.io

UPLOAD_MAX_MB=10
SESSION_TTL_HOURS=72

# Anthropic model used by the Python AI backend; surfaced here so Node can
# echo it in the canvas footer / report metadata for transparency.
ANTHROPIC_MODEL=claude-sonnet-4-6
