{
  "name": "portfolio-gps-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n node,python -c blue,green \"tsx watch src/index.ts\" \"tsx src/mocks/mockPython.ts\"",
    "dev:node": "tsx watch src/index.ts",
    "mock:python": "tsx src/mocks/mockPython.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.28",
    "@langchain/core": "^1.1.43",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "langfuse": "^3.38.20",
    "langfuse-langchain": "^3.38.20",
    "multer": "^1.4.5-lts.2",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^11.1.0",
    "ws": "^8.18.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.14",
    "@vitest/coverage-v8": "^3.1.3",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
